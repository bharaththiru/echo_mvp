platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('Flutter', 'Generated.xcconfig'),
    __dir__
  )
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting the file and running flutter pub get."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  # Use static frameworks to avoid non-modular header issues with Firebase
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

def scrub_and_normalize_flags(config)
  # Drop unsupported -G flags while keeping anything CocoaPods adds.
  normalize = lambda do |key, required_tokens|
    raw = config.build_settings[key]
    tokens = Array(raw).flat_map { |v| v.to_s.split(/\s+/) }
    tokens = tokens.reject { |flag| flag.start_with?('-G') }
    tokens += required_tokens
    tokens << '$(inherited)'
    tokens = tokens.compact.reject(&:empty?).uniq
    config.build_settings[key] = tokens.join(' ')
  end

  normalize.call('OTHER_CFLAGS', [])
  normalize.call('OTHER_CPLUSPLUSFLAGS', ['-std=gnu++17'])
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Apply general build settings to all valid targets
    if target.respond_to?(:build_configurations)
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        
        # Xcode 16 specific compatibility settings
        config.build_settings['EXPLICIT_MODULE_BUILD'] = 'NO'
        config.build_settings['SWIFT_PRECOMPILE_MODULES'] = 'NO'
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end

    # The specific fix for the "-G" error (BoringSSL-GRPC)
    # The 'respond_to?' check prevents the "undefined method" error
    if target.name == 'BoringSSL-GRPC' && target.respond_to?(:source_build_phase)
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end

  end
end
