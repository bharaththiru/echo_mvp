platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('Flutter', 'Generated.xcconfig'),
    __dir__
  )
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting the file and running flutter pub get."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  # Use static frameworks to avoid non-modular header issues with Firebase
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

def scrub_and_normalize_flags(config)
  # Drop unsupported -G flags while keeping anything CocoaPods adds.
  normalize = lambda do |key, required_tokens|
    raw = config.build_settings[key]
    tokens = Array(raw).flat_map { |v| v.to_s.split(/\s+/) }
    tokens = tokens.reject { |flag| flag.start_with?('-G') }
    tokens += required_tokens
    tokens << '$(inherited)'
    tokens = tokens.compact.reject(&:empty?).uniq
    config.build_settings[key] = tokens.join(' ')
  end

  normalize.call('OTHER_CFLAGS', [])
  normalize.call('OTHER_CPLUSPLUSFLAGS', ['-std=gnu++17'])
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Align pods with the app's deployment target and avoid Xcode 16+ module/precompile issues.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
      config.build_settings['EXPLICIT_MODULE_BUILD'] = 'NO'
      config.build_settings['SWIFT_PRECOMPILE_MODULES'] = 'NO'
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      scrub_and_normalize_flags(config)
    end
  end

  # Also scrub the main app target (Runner) because Flutter/Pod install can re-introduce flags there.
  app_project_path = File.join(__dir__, 'Runner.xcodeproj')
  if File.exist?(app_project_path)
    app_project = Xcodeproj::Project.open(app_project_path)
    app_project.build_configurations.each { |config| scrub_and_normalize_flags(config) }
    app_project.save
  end

  # Apply the flag scrub at the project level too so generated xcconfigs stay clean.
  installer.pods_project.build_configurations.each do |config|
    scrub_and_normalize_flags(config)
  end
end
